{
  "name": "opencode-dynamic-workflow",
  "version": "0.1.0",
  "description": "Dynamic workflows as a first-class citizen in opencode v2: the model writes a constrained script, the plugin runs it deterministically, and every worker is a host sub-session.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "test:unit": "vitest run tests/unit --reporter=dot",
    "test:contract": "vitest run tests/contract --reporter=dot"
  },
  "dependencies": {
    "@opencode/plugin": ">=2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
